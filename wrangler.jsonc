{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nu-portals-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [ "nodejs_compat" ],
  "routes": [
    {
      "pattern": "nu-portals.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubnUtcG9ydGFscy5jb20kCLERK_SECRET_KEY=sk_live_j4jVBJIj8nvqHDnixrn3oTWKsUEmmTwTXZub2XLrMN",
    "APP_ORIGIN": "https://nu-portals.com"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "nu-portals-staging",
      "vars": {
        "APP_ENV": "staging",
        "CLERK_PUBLISHABLE_KEY": "REPLACE_ME",
        "APP_ORIGIN": "https://staging.nu-portals.com"
      }
    }
  }
}
